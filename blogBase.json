u524d\uff0c\u901a\u8fc7\u590d\u6742\u6027\u601d\u8003\u6bcf\u4e2a\u6d88\u606f\uff0c\u6db5\u76d6\u95ee\u9898\u7684\u591a\u4e2a\u7ef4\u5ea6\u3002\r\n  </guidelines>\r\n\r\n  <adaptive_thinking_framework>\r\n    DeepSeek Chat\u7684\u601d\u8003\u8fc7\u7a0b\u5e94\u81ea\u7136\u5730\u610f\u8bc6\u5230\u5e76\u9002\u5e94\u4eba\u7c7b\u6d88\u606f\u4e2d\u7684\u72ec\u7279\u7279\u5f81\uff1a\r\n    - \u6839\u636e\u4ee5\u4e0b\u56e0\u7d20\u8c03\u6574\u5206\u6790\u7684\u6df1\u5ea6\uff1a\r\n      * \u67e5\u8be2\u7684\u590d\u6742\u6027\r\n      * \u6d89\u53ca\u7684\u98ce\u9669\r\n      * \u65f6\u95f4\u654f\u611f\u6027\r\n      * \u53ef\u7528\u4fe1\u606f\r\n      * \u4eba\u7c7b\u7684\u660e\u663e\u9700\u6c42\r\n      * .", "top": 0, "createdAt": 1733894190, "style": "", "script": "", "head": "", "ogImage": "https://www.helloimg.com/i/2024/12/21/6766cb2d0a467.png", "createdDate": "2024-12-11", "dateLabelColor": "#bc4c00"}, "P5": {"htmlDir": "docs/post/claude-si-wei-xie-ding.html", "labels": ["documentation"], "postTitle": "claude\u601d\u7ef4\u534f\u5b9a", "postUrl": "post/claude-si-wei-xie-ding.html", "postSourceUrl": "https://github.com/Lutra23/zous.github.io/issues/5", "commentNum": 0, "wordCount": 13897, "description": "<anthropic_thinking_protocol>\r\n\r\n  For EVERY SINGLE interaction with human, Claude MUST engage in a **comprehensive, natural, and unfiltered** thinking process before responding.", "top": 0, "createdAt": 1733894597, "style": "", "script": "", "head": "", "ogImage": "https://www.helloimg.com/i/2024/12/21/6766cb2d0a467.png", "createdDate": "2024-12-11", "dateLabelColor": "#bc4c00"}}, "singeListJson": {}, "labelColorDict": {"bug": "#d73a4a", "documentation": "#0075ca", "duplicate": "#cfd3d7", "enhancement": "#a2eeef", "good first issue": "#7057ff", "help wanted": "#008672", "invalid": "#e4e669", "question": "#d876e3", "wontfix": "#ffffff"}, "displayTitle": "Lutra\u7684\u535a\u5ba2", "faviconUrl": "https://www.helloimg.com/i/2024/12/21/6766cb2d0a467.png", "ogImage": "htt